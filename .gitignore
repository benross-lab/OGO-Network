poc-4validator/chain/**/node.log
chain/snapshots/
poc-4validator/chain/snapshots/
*.tar.gz

# Validator and node key material (never commit, anywhere)
**/priv_validator_key.json
**/priv_validator_state.json
**/node_key.json
**/keys/
*.pem
*.key
.env
.env.*

# Go build cache
.go-build-cache/
